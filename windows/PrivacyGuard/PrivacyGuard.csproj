<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PrivacyGuard.App</RootNamespace>
    <AssemblyName>PrivacyGuard</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>PrivacyGuard.App.Program</StartupObject>
    <Version>0.1.0</Version>
    <Product>Privacy Guard</Product>
    <Copyright>GPL-3.0-or-later</Copyright>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrivacyGuard.Platform\PrivacyGuard.Platform.csproj" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
