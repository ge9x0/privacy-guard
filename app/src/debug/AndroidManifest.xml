<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: test for the "microphone with the screen off" notification. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application>
        <!-- only adb/the system (they hold DUMP) can start it -->
        <receiver
            android:name=".debug.TestMicReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.TimingReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.ClearHistoryReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
