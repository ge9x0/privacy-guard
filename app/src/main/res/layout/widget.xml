<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Privacy Guard" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/alerts" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="–" android:textColor="#FFFFB4A9" android:textSize="13sp" />
    <TextView android:id="@+id/line2" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFCAC4D0" android:textSize="12sp" />
    <TextView android:id="@+id/vpn" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="" android:textColor="#FFCAC4D0" android:textSize="12sp" />
</LinearLayout>
